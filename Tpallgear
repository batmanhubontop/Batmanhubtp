-- 📩 ฟังก์ชันส่งแจ้งเตือนเข้า Discord Webhook
local function SendDiscordWebhook(title, description, color)
    if not WEBHOOK_URL or WEBHOOK_URL == "" then return end
    
    local currentTime = os.time()
    if currentTime - lastWebhookSent < WEBHOOK_COOLDOWN then
        return -- ยังไม่ครบ 30 วินาที ข้ามการส่ง
    end
    lastWebhookSent = currentTime

    local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not requestFunc then return end

    local data = {
        ["embeds"] = {{
            ["title"] = title,
            ["description"] = description,
            ["color"] = color or 16711680, -- สีแดง
            ["footer"] = {
                ["text"] = "Batman Verification System • " .. os.date("%X")
            }
        }}
    }

    pcall(function()
        requestFunc({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
    end)
end

-- 💾 ฟังก์ชันระบบ Auto-Save
local function ReadSavedID()
    if readfile and isfile and isfile(SAVE_FILE_NAME) then
        local success, result = pcall(function() return readfile(SAVE_FILE_NAME) end)
        if success and result then
            return string.match(result, "%d+")
        end
    end
    return nil
end

local function SaveID(id)
    if writefile then
        pcall(function()
            writefile(SAVE_FILE_NAME, tostring(id))
        end)
    end
end

-- 🔐 ฟังก์ชันตรวจสอบสิทธิ์ (ซ่อนเลข ID ไม่ให้โชว์บน UI)
local function VerifyAccess(inputId)
    local cleanInput = string.match(tostring(inputId), "%d+") or ""
    local myUserId = tostring(LocalPlayer.UserId)

    if cleanInput == "" then
        return false, "❌ กรุณากรอก User ID ที่ถูกต้อง!"
    end

    if cleanInput ~= myUserId then
        -- ส่งแจ้งเตือนไปยัง Discord Webhook (ติด Cooldown 30 วินาที)
        SendDiscordWebhook(
            "⚠️ มีการพยายามรันสคริปต์ผิดไอดี",
            "**ผู้ใช้ในเกม:** " .. LocalPlayer.Name .. " (" .. myUserId .. ")\n**ID ที่กรอก:** " .. cleanInput,
            16711680
        )
        -- คืนค่าข้อความสะอาด โดยไม่มีเลข ID โผล่บนหน้าจอ
        return false, "❌ User ID ไม่ตรงกับตัวละครนี้!"
    end

    return true, "✅ ยืนยันไอดีสำเร็จ!", cleanInput
end

